# Learner-facing read-only connection (used by the app in Phase 2+).
DATABASE_URL=postgresql://sql_gym_readonly:readonly@localhost:5432/sqlgym

# Max milliseconds for a learner SELECT before PostgreSQL cancels it (default 30000).
# SQL_STATEMENT_TIMEOUT_MS=30000

# Admin connection for Times import (sqlgym superuser from docker-compose).
DATABASE_ADMIN_URL=postgresql://sqlgym:sqlgym@localhost:5432/sqlgym

# App environment: development (default) or production.
# When APP_ENV=production, SESSION_SECRET is required (hard-fail at startup).
# APP_ENV=development

# Starlette session + progress-cookie signing secret.
# Required when APP_ENV=production. In development a committed fallback is used if unset.
SESSION_SECRET=change-me-in-production

# GCS source for Times Archive slim NDJSON (private times-api bucket).
GCS_BUCKET=ny-archive-bucket
GCS_PREFIX=nyt-ingest/archive_slim

# Path to a GCP service account JSON with storage.objectViewer on the bucket.
# Cloud Agents: map the injected secret to this path or use scripts/import-times-from-times-api.sh
# which also accepts the "GCS View SA" Cloud secret env var.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
